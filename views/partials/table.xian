<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">

    <div class="p-6 border-b border-gray-200">

        <h2 class="text-lg font-semibold text-gray-800">
            Recent Transactions
        </h2>

        <p class="text-sm text-gray-500">
            Latest transactions
        </p>

    </div>

    <div class="overflow-x-auto">

        <table class="w-full text-left">

            <thead class="bg-gray-50">

                <tr>

                    <th class="px-6 py-4">
                        Name
                    </th>

                    <th class="px-6 py-4">
                        Email
                    </th>

                    <th class="px-6 py-4">
                        Amount
                    </th>

                    <th class="px-6 py-4">
                        Status
                    </th>

                </tr>

            </thead>

            <tbody>

                {{#each transactions}}

                <tr class="border-t border-gray-200">

                    <td class="px-6 py-4">
                        {{name}}
                    </td>

                    <td class="px-6 py-4">
                        {{email}}
                    </td>

                    <td class="px-6 py-4">
                        {{amount}}
                    </td>

                    <td class="px-6 py-4">
                        {{status}}
                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</div>